# Hand-edited after `save_as_session --use-foreground-process`. Two deviations
# from what kitty writes, both needed because of powerlevel10k instant prompt:
#
# 1. `launch` runs `kitten ssh` directly instead of stashing it in the saved
#    form `launch 'kitty-unserialize-data={..., "cmd_at_shell_startup": [...]}'`.
#    With that form kitty starts the *local* zsh and exports
#    KITTY_SI_RUN_COMMAND_AT_STARTUP; shell integration then runs it from a
#    precmd hook (shell-integration/zsh/kitty-integration: `builtin eval $krcs`).
#    p10k instant prompt has already done `exec ... 0<&$fd_null` by then, so the
#    ssh kitten sees a non-tty STDIN and dies with
#    "The SSH kitten is meant for interactive use only, STDIN must be a terminal".
#    Launched directly, kitty gives the kitten the window pty. The JSON keeps
#    only "id", which set_layout_state below matches windows by.
#
# 2. The remote startup command carries `< /dev/tty > /dev/tty 2>&1`. Same p10k
#    trap on `benbr`, one level in: the remote shell integration evals
#    KITTY_SI_RUN_COMMAND_AT_STARTUP while instant prompt still points fd 0 at
#    /dev/null, so `nvi` / `zmx attach` bail out. Reordering precmd_functions on
#    the remote does not help (remote p10k restores the fds after the precmd
#    hooks, not during); reattaching the tty inside the command does, because
#    $krcs goes through `eval` and shell redirections apply.
#
# Re-saving this session over itself reverts both — re-apply by hand.

new_tab ben: neovim
layout tall:bias=70;full_size=1
enabled_layouts tall:bias=70;full_size=1,stack
set_layout_state {"main_bias": [0.7, 0.30000000000000004], "biased_map": {}, "opts": {"full_size": 1, "bias": 70, "mirrored": "n"}, "class": "Tall", "all_windows": {"active_group_idx": 0, "active_group_history": [4], "window_groups": [{"id": 4, "window_ids": [5]}]}}
cd /home/junyi

launch 'kitty-unserialize-data={"id": 5}' /usr/bin/kitten ssh '--kitten=env=KITTY_SI_RUN_COMMAND_AT_STARTUP=nvi < /dev/tty > /dev/tty 2>&1' --kitten=cwd=/home/xujunyi/WorkSpace/iso-plainmid-probe-rclone benbr
focus

